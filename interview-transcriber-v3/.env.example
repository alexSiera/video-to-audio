# =============================================================================
# interview-transcriber-v3 — пример переменных окружения.
# Скопируйте в `.env` и заполните значениями. Никогда не коммитьте `.env`.
# Все переменные читаются docker-compose и приложениями (apps/api, apps/worker).
# =============================================================================

# --- Common / App ---
APP_ENV=dev                                  # dev | prod | test
LOG_LEVEL=DEBUG                              # DEBUG | INFO | WARNING | ERROR
WEB_ORIGIN=http://localhost:3000             # origin фронтенда для CORS
SENTRY_DSN=                                  # DSN Sentry (опционально в dev)
OTEL_EXPORTER_OTLP_ENDPOINT=                 # endpoint OTLP collector (опционально)
OTEL_SERVICE_NAME=interview-transcriber-v3

# --- PostgreSQL ---
POSTGRES_USER=itr
POSTGRES_PASSWORD=itr
POSTGRES_DB=interview_transcriber
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://itr:itr@postgres:5432/interview_transcriber

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Object Storage (MinIO / S3) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_MEDIA=media
S3_BUCKET_ARTIFACTS=artifacts
S3_BUCKET_EXPORTS=exports
S3_USE_PATH_STYLE=true                      # true для MinIO; false для AWS S3
S3_PRESIGNED_TTL_SECONDS=3600

# --- Upload limits ---
MAX_UPLOAD_BYTES=2147483648                  # 2 GiB (аудио)
MAX_AUDIO_DURATION_HOURS=10
UPLOAD_PART_BYTES=8388608                    # 8 MiB

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=900                   # 15 мин
JWT_REFRESH_TTL_SECONDS=2592000              # 30 дней

# --- OAuth ---
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# --- Rate limits (per-user/per-ip) ---
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_UPLOAD_PER_MIN=10
RATE_LIMIT_DEFAULT_PER_MIN=100

# --- STT (apps/stt-service) ---
STT_MODEL=faster-whisper-large-v3            # ключ из реестра моделей
STT_DEVICE=cuda                              # cuda | cpu
STT_COMPUTE_TYPE=float16                     # float16 | int8 | float32
STT_DEFAULT_LANGUAGE=ru                      # ru | en | auto
HUGGINGFACE_TOKEN=                           # для gated моделей (pyannote и др.)

# --- Diarization ---
DIARIZATION_ENGINE=pyannote                  # pyannote | nemo
DIARIZATION_ENABLED=true
